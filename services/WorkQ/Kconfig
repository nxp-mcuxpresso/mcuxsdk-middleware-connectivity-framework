menuconfig MCUX_COMPONENT_middleware.wireless.framework.workq
    bool "Simple workqueue threads"
    select MCUX_COMPONENT_component.osa
    select MCUX_COMPONENT_component.lists
    help
      Use workqueues to defer processing to shared threads.

if MCUX_COMPONENT_middleware.wireless.framework.workq
  menu "Work queue config"
      config FWK_SYSWORKQ_STACK_SIZE
          int "WorkQueue stack size"
          default 1700 if MCUX_COMPONENT_middleware.wireless.framework.seclib_rng_port.psa \
                          && MCUX_COMPONENT_utilities.gcov
          default 1500 if MCUX_COMPONENT_middleware.wireless.framework.seclib_rng_port.psa
          default 850  if MCUX_COMPONENT_utilities.gcov
          default 608
          help
              Macro to set work queue task stack size.
      config FWK_SYSWORKQ_PRIO
          int "WorkQueue task priority"
          default 14 if MCUX_COMPONENT_component.osa_bm
          default 4
          help
              Macro to set the system work queue task priority, usually set to a lower priority than other tasks.
              The priority value and logic depends on the OS: on BM (bare metal), higher numeric values mean lower priority.
              On FreeRTOS and ThreadX, lower numeric values mean lower priority.

  endmenu
endif