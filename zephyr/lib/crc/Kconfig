config CRC
	bool
	help
	  Enable use of CRC.

# Build the framework CRC lib only when edgefast_open does not already provide
# it, so a combined build links a single copy.
config MCUX_COMPONENT_middleware.wireless.framework.zephyr_lib.crc
	bool
	default y if CRC && MCUX_COMPONENT_middleware.wireless.framework.zephyr_common && !MCUX_COMPONENT_middleware.edgefast_open.crc

if CRC
endif
